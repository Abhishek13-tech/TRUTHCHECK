# ---------------------------------------------------------
# TRUTHCHECK - Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in the real values in your .env file
#   3. NEVER commit .env to Git (it is already in .gitignore)
# ---------------------------------------------------------

# Gmail credentials for OTP emails
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Firebase Configuration
# Get these from: https://console.firebase.google.com > Project Settings
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
